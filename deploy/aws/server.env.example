DANTOPHONG_PORT=9000
DANTOPHONG_SECONDARY_PORT=
DANTOPHONG_DB_CONNECTION=Server=<RDS-ENDPOINT>,1433;Database=DanToPhongDB;User Id=<DB-USER>;Password=<SET-OUTSIDE-GIT>;Encrypt=True;TrustServerCertificate=False;
DANTOPHONG_SMTP_HOST=smtp.gmail.com
DANTOPHONG_SMTP_PORT=465
DANTOPHONG_SMTP_USER=
DANTOPHONG_SMTP_PASSWORD=
DANTOPHONG_USE_TLS=true
DANTOPHONG_CERT_PATH=/etc/dantophong/server.pfx
DANTOPHONG_CERT_PASSWORD=
